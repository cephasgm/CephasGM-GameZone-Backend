# ============================================================
# CephasGM GameZone — PRODUCTION Environment
# ============================================================
# Copy this to .env.production on your server and fill in real
# values. NEVER commit .env.production to Git.
# ============================================================

# ---------- APP ----------
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
APP_NAME=CephasGM GameZone
APP_URL=https://api.cephasgm.com
FRONTEND_URL=https://cephasgm.github.io/CephasGM-GameZone
CORS_ORIGINS=https://cephasgm.github.io,https://cephasgm.com,https://www.cephasgm.com

# ---------- DATABASE ----------
# Get this from Render Postgres, Railway, Neon, Supabase, or your VPS
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require

# ---------- JWT ----------
# Generate fresh ones for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ---------- OTP ----------
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10
EMAIL_VERIFICATION_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_MINUTES=30

# ---------- RATE LIMIT ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
BET_RATE_LIMIT_MAX=30

# ---------- EMAIL ----------
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=apikey
MAIL_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM_NAME=CephasGM GameZone
MAIL_FROM_ADDRESS=no-reply@cephasgm.com

# ---------- SMS ----------
SMS_PROVIDER=africastalking
AT_USERNAME=cephasgm
AT_API_KEY=atsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AT_SENDER_ID=CEPHASGM

# ---------- CLOUDINARY ----------
CLOUDINARY_CLOUD_NAME=your_cloud
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret
CLOUDINARY_UPLOAD_FOLDER=cephasgm/kyc

# ---------- PAYMENTS ----------
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_WEBHOOK_HASH=your_webhook_hash
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

MPESA_CONSUMER_KEY=your_key
MPESA_CONSUMER_SECRET=your_secret
MPESA_PASSKEY=your_passkey
MPESA_SHORTCODE=your_shortcode
MPESA_ENVIRONMENT=production
MPESA_CALLBACK_URL=https://api.cephasgm.com/api/v1/deposits/webhook/mpesa

TIGO_PESA_API_KEY=
TIGO_PESA_API_SECRET=
TIGO_PESA_MERCHANT_ID=

AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_MERCHANT_ID=

# ---------- WALLET / BETTING ----------
DEFAULT_CURRENCY=TZS
MIN_DEPOSIT=1000
MAX_DEPOSIT=5000000
MIN_WITHDRAWAL=5000
MAX_WITHDRAWAL=10000000
MIN_BET=500
MAX_BET=1000000
WITHDRAWAL_FEE_PERCENT=2
HOUSE_EDGE_PERCENT=5

# ---------- VIRTUAL GAMES ----------
VIRTUAL_ROUND_INTERVAL_MS=60000
AVIATOR_MIN_CRASH=1.0
AVIATOR_MAX_CRASH=60.0
AVIATOR_HOUSE_EDGE=0.04
# CRITICAL: use a real random seed, kept secret forever
PROVABLY_FAIR_SERVER_SEED=

# ---------- BONUSES / REFERRALS ----------
WELCOME_BONUS_AMOUNT=5000
WELCOME_BONUS_WAGER_MULTIPLIER=5
REFERRAL_COMMISSION_PERCENT=5
REFERRAL_MIN_DEPOSIT=5000

# ---------- VIP ----------
VIP_TIERS=Bronze,Silver,Gold,Platinum,Diamond
VIP_BRONZE_THRESHOLD=0
VIP_SILVER_THRESHOLD=100000
VIP_GOLD_THRESHOLD=500000
VIP_PLATINUM_THRESHOLD=2000000
VIP_DIAMOND_THRESHOLD=10000000

# ---------- LOGGING ----------
LOG_LEVEL=info
LOG_PRETTY=false
LOG_FILE=logs/app.log

# ---------- SECURITY ----------
COOKIE_SECRET=
SESSION_SECRET=

# ---------- ADMIN ----------
ADMIN_EMAIL=admin@cephasgm.com
ADMIN_PASSWORD=
ADMIN_PHONE=+255700000000

# ---------- REDIS ----------
# Enable Redis in production for distributed rate limiting
REDIS_URL=redis://default:PASSWORD@HOST:6379
REDIS_ENABLED=true