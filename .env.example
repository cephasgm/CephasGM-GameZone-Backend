# ============================================================
# CephasGM GameZone — Backend Environment Variables
# ============================================================
# Copy this file to `.env` and replace all placeholder values.
#   cp .env.example .env
# Never commit `.env` to Git — it is in .gitignore.
# ============================================================

# ------------------------------------------------------------
# APP
# ------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME="CephasGM GameZone"
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5500
CORS_ORIGINS=http://localhost:5500,http://localhost:3000,http://127.0.0.1:5500

# ------------------------------------------------------------
# DATABASE — PostgreSQL
# ------------------------------------------------------------
# Local dev (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://cephasgm:cephasgm_dev_password@localhost:5432/cephasgm_gamezone?schema=public"

# Production example (Render / Railway / Supabase / Neon):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require"

# ------------------------------------------------------------
# JWT — Authentication
# ------------------------------------------------------------
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_64_char_hex_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_me_with_a_different_64_char_hex_string
JWT_REFRESH_EXPIRES_IN=30d

# Password hashing rounds — 12 is a good balance of speed vs security
BCRYPT_ROUNDS=12

# ------------------------------------------------------------
# OTP / Verification
# ------------------------------------------------------------
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10
EMAIL_VERIFICATION_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_MINUTES=30

# ------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
BET_RATE_LIMIT_MAX=30

# ------------------------------------------------------------
# EMAIL — SMTP (Gmail / Sendgrid / Resend / Mailgun)
# ------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM_NAME="CephasGM GameZone"
MAIL_FROM_ADDRESS=no-reply@cephasgm.com

# ------------------------------------------------------------
# SMS — Africa's Talking (Tanzania / Kenya / Uganda)
# ------------------------------------------------------------
SMS_PROVIDER=africastalking
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key
AT_SENDER_ID=CEPHASGM

# Twilio alternative (leave blank if using Africa's Talking)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------
# CLOUDINARY — KYC docs, profile photos, avatars
# ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_FOLDER=cephasgm/kyc

# ------------------------------------------------------------
# PAYMENTS — Flutterwave (cards, mobile money)
# ------------------------------------------------------------
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_WEBHOOK_HASH=your_webhook_verification_hash
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# ------------------------------------------------------------
# PAYMENTS — M-Pesa (Vodacom Tanzania)
# ------------------------------------------------------------
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_PASSKEY=your_lipa_na_mpesa_passkey
MPESA_SHORTCODE=174379
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/deposit/mpesa/callback

# ------------------------------------------------------------
# PAYMENTS — Tigo Pesa
# ------------------------------------------------------------
TIGO_PESA_API_KEY=your_tigo_pesa_key
TIGO_PESA_API_SECRET=your_tigo_pesa_secret
TIGO_PESA_MERCHANT_ID=your_merchant_id

# ------------------------------------------------------------
# PAYMENTS — Airtel Money
# ------------------------------------------------------------
AIRTEL_CLIENT_ID=your_airtel_client_id
AIRTEL_CLIENT_SECRET=your_airtel_client_secret
AIRTEL_MERCHANT_ID=your_merchant_id

# ------------------------------------------------------------
# WALLET / BETTING RULES
# ------------------------------------------------------------
DEFAULT_CURRENCY=TZS
MIN_DEPOSIT=1000
MAX_DEPOSIT=5000000
MIN_WITHDRAWAL=5000
MAX_WITHDRAWAL=10000000
MIN_BET=500
MAX_BET=1000000
WITHDRAWAL_FEE_PERCENT=2
HOUSE_EDGE_PERCENT=5

# ------------------------------------------------------------
# VIRTUAL GAMES
# ------------------------------------------------------------
VIRTUAL_ROUND_INTERVAL_MS=60000
AVIATOR_MIN_CRASH=1.00
AVIATOR_MAX_CRASH=60.00
AVIATOR_HOUSE_EDGE=0.04
PROVABLY_FAIR_SERVER_SEED=replace_me_with_a_random_32_char_hex

# ------------------------------------------------------------
# BONUSES / REFERRALS
# ------------------------------------------------------------
WELCOME_BONUS_AMOUNT=5000
WELCOME_BONUS_WAGER_MULTIPLIER=5
REFERRAL_COMMISSION_PERCENT=5
REFERRAL_MIN_DEPOSIT=5000

# ------------------------------------------------------------
# VIP TIERS
# ------------------------------------------------------------
VIP_TIERS=Bronze,Silver,Gold,Platinum,Diamond
VIP_BRONZE_THRESHOLD=0
VIP_SILVER_THRESHOLD=100000
VIP_GOLD_THRESHOLD=500000
VIP_PLATINUM_THRESHOLD=2000000
VIP_DIAMOND_THRESHOLD=10000000

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------
LOG_LEVEL=debug
LOG_PRETTY=true
LOG_FILE=logs/app.log

# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------
COOKIE_SECRET=replace_me_with_a_random_secret
SESSION_SECRET=replace_me_with_a_random_secret

# ------------------------------------------------------------
# ADMIN BOOTSTRAP
# ------------------------------------------------------------
# Used only by `npm run seed` to create the first admin account.
ADMIN_EMAIL=admin@cephasgm.com
ADMIN_PASSWORD=ChangeMe_Str0ng!Pass
ADMIN_PHONE=+255700000000

# ------------------------------------------------------------
# REDIS (optional — for rate limiting, sessions, queues)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# ------------------------------------------------------------
# DOCKER POSTGRES (used by docker-compose.yml)
# ------------------------------------------------------------
POSTGRES_USER=cephasgm
POSTGRES_PASSWORD=cephasgm_dev_password
POSTGRES_DB=cephasgm_gamezone
POSTGRES_PORT=5432