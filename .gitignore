# ============================================================
# CephasGM GameZone — Backend .gitignore
# ============================================================

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.yarn-integrity
.pnpm-store/

# Environment files
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local
!.env.example

# Logs
logs/
*.log
pino-*.log

# Prisma
prisma/*.db
prisma/*.db-journal
prisma/migrations/dev.db*
prisma/.env

# Build output
dist/
build/
out/
.next/
.cache/
.temp/
tmp/

# Test coverage
coverage/
.nyc_output/
*.lcov

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS files
.DS_Store
._*
.Thumbs.db
Thumbs.db
desktop.ini

# Uploads
uploads/
tmp-uploads/
public/uploads/

# Docker overrides
docker-compose.override.yml
.docker/

# Docker compose override for local personal config
docker-compose.override.yml

# Misc
.eslintcache
.prettiercache
.stylelintcache
*.pid
*.seed
node_modules/.cache/

# ------------------------------------------------------------
# Temporary debug / test files
# ------------------------------------------------------------
diag.js
pgtest.js
tmp-*.js
test-*.js
!tests/**/*.js